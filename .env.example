# =========================================================================
# MindSpace — environment configuration
# Copy this file to `.env` and edit the values for your own setup.
# =========================================================================

# ----- MySQL connection -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mindspace
MYSQL_PASSWORD=mindspace_pass
MYSQL_DB=mindspace

# Alternatively, set a full DATABASE_URL (this takes precedence over the
# MYSQL_* variables above). Example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mindspace?charset=utf8mb4

# ----- Secrets (CHANGE THESE in production) -----
SECRET_KEY=please-change-this-flask-secret-key
JWT_SECRET_KEY=please-change-this-jwt-secret-key

# ----- Default admin account (seeded on first run) -----
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ----- Dev server -----
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=1

# ----- Quick local testing without MySQL -----
# Uncomment to fall back to a local SQLite file (handy if you just
# want to try the app without setting up MySQL).
# USE_SQLITE=1
