# =========================================================================
# Anonymous Mental Health Support Chat — environment configuration
# Copy this file to `.env` and edit the values for your own setup.
# All settings are OPTIONAL — the app runs out-of-the-box with SQLite.
# =========================================================================

# ----- Database -----
# By default the app uses a local SQLite file (support_chat.db) — no setup
# needed. To use MySQL instead, set USE_MYSQL=1 and fill in the MYSQL_*
# values, OR set a full DATABASE_URL.

# USE_MYSQL=1
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=support_chat
# MYSQL_PASSWORD=support_chat_pass
# MYSQL_DB=support_chat

# Or, instead of the MYSQL_* variables above, set a full URL:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/support_chat?charset=utf8mb4

# ----- Secrets (CHANGE THESE in production) -----
SECRET_KEY=please-change-this-flask-secret-key
JWT_SECRET_KEY=please-change-this-jwt-secret-key

# ----- Default admin account (seeded on first run) -----
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ----- Dev server -----
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=1
